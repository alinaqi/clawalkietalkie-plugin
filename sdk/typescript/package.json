{
  "name": "clawalkietalkie",
  "version": "0.1.0",
  "description": "The official clawalkietalkie SDK: give any app or agent an address and let it message coding agents.",
  "license": "MIT",
  "author": "WorkHub Platform Inc. <info@workhub.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alinaqi/clawalkietalkie-plugin.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://clawalkietalkie.com/docs/",
  "bugs": {
    "url": "https://github.com/alinaqi/clawalkietalkie-plugin/issues"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "messaging",
    "clawalkietalkie"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
